{
  "name": "axioma-wms",
  "productName": "Axioma WMS",
  "version": "1.3.0",
  "description": "Axioma WMS — Workshop Management System",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dir",
    "make-icon": "electron scripts/make-icon.js",
    "smoke": "BELO_SMOKE=1 BELO_DATA=./.smoke/data BELO_OUT=./.smoke/out electron .",
    "load": "node test/load.js .load",
    "perf": "BELO_PERF=1 BELO_DATA=./.load BELO_OUT=./.perf electron ."
  },
  "devDependencies": {
    "electron": "44.10.1",
    "electron-builder": "26.17.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-sans-georgian": "5.3.0"
  },
  "build": {
    "appId": "ge.belo.wms",
    "productName": "Axioma WMS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Axioma WMS",
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "Axioma WMS"
    },
    "copyright": "© 2026 Axioma Software LLC"
  },
  "author": "Axioma Software LLC",
  "homepage": "https://axiomasoft.ge/"
}
